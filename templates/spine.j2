! {{ name }} -- GENERATED by scripts/gen_configs.py. Do not hand-edit.
! Source of truth: topology/dc-fabric.yml + topology/link-map.yml
!
! A spine is deliberately dumb: it runs the underlay and reflects BGP routes. It
! holds no VLANs, no SVIs, and no host-facing ports. Every leaf added later needs
! exactly two lines here and nothing else.
!
hostname {{ name }}
!
no ip domain lookup
ip domain name {{ domain }}
ip routing
!
username {{ user }} privilege 15 secret {{ password }}
enable secret {{ password }}
!
interface Loopback0
 description router-id and BGP peering source
 ip address {{ loopback }} 255.255.255.255
 ip ospf 1 area {{ area }}
!
{% for l in links %}
interface {{ l.intf }}
 description to {{ l.peer }}
 ip address {{ l.ip }} 255.255.255.254
 ! point-to-point: skip DR/BDR election, which is meaningless on a /31
 ip ospf network point-to-point
 ip ospf 1 area {{ area }}
 no shutdown
!
{% endfor %}
router ospf 1
 router-id {{ loopback }}
 passive-interface Loopback0
!
! iBGP, AS {{ asn }}. Both spines are route reflectors so the leaves never have to
! peer with each other -- that is what keeps adding a leaf an O(1) change.
router bgp {{ asn }}
 bgp router-id {{ loopback }}
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor LEAVES peer-group
 neighbor LEAVES remote-as {{ asn }}
 neighbor LEAVES update-source Loopback0
{% for c in clients %}
 neighbor {{ c }} peer-group LEAVES
{% endfor %}
 !
 address-family ipv4
  neighbor LEAVES route-reflector-client
{% for c in clients %}
  neighbor {{ c }} activate
{% endfor %}
 exit-address-family
{% if overlay %}
 !
 ! Phase 2. The spine reflects EVPN routes and still holds no VLAN, no SVI and no
 ! VNI -- it never learns a tenant MAC, it only passes the advertisements around.
 ! That is the property that keeps a spine cheap as the fabric grows.
 !
 ! 'send-community both' is not optional here: EVPN carries its route targets in
 ! extended communities, so without it the leaves exchange routes that every
 ! receiver then discards for having no importable RT.
 address-family l2vpn evpn
  neighbor LEAVES send-community both
  neighbor LEAVES route-reflector-client
{% for c in clients %}
  neighbor {{ c }} activate
{% endfor %}
 exit-address-family
{% endif %}
!
ip ssh version 2
line vty 0 4
 login local
 ! telnet stays enabled deliberately. SSH will not listen until an RSA key exists,
 ! and 'transport input ssh' alone means a box with no key has no management plane
 ! at all -- console only. Telnet is the bootstrap path back in. In-band and
 ! reachable only through the jump, so the exposure is the lab itself.
 transport input telnet ssh
!
! IOS refuses to generate an RSA key from a startup-config -- it is an exec-mode
! action. Without this applet the box boots with SSH configured and no key, so
! Ansible cannot get in and you are stuck on the console. The timer gives the
! hostname and domain time to settle first; both are inputs to the key label.
!
! This line is the part that is easy to miss: with 'login local' on the vty, EEM's
! cli actions need an authorized session or they fail silently -- the applet runs,
! logs nothing useful, and no key appears.
event manager session cli username "{{ user }}"
!
event manager applet SSH-KEYGEN
 event timer countdown time 60
 action 1.0 cli command "enable"
 action 2.0 cli command "configure terminal"
 action 3.0 cli command "crypto key generate rsa modulus 2048"
 action 4.0 cli command "end"
 action 5.0 syslog msg "SSH host key generated"
!
end
