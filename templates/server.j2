#!/bin/sh
# {{ name }} -- GENERATED by scripts/gen_configs.py. Do not hand-edit.
#
# Deliberately minimal. CML's alpine node definition declares
#   configuration.generator.driver = "alpine"
# and provisions node.cfg, which the generator reads for a small set of known
# directives. 'hostname' is honoured; arbitrary shell -- file writes, ip commands,
# /etc/local.d hooks -- is not, and fails silently. The node boots clean with none
# of it applied, which is a genuinely annoying way to lose an afternoon.
#
# So this host gets its address from DHCP on {{ leaf }} instead. The pool there is
# narrowed to exactly {{ ip }}, so the result is deterministic anyway -- and
# handing out host addresses from the leaf is what a real fabric does.
#
# Expected after boot: {{ ip }}/{{ prefix }} on {{ iface }}, gateway {{ gateway }}, VLAN {{ vlan }}.

hostname {{ name }}

USERNAME={{ user }}
PASSWORD={{ password }}
