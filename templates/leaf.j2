! {{ name }} -- GENERATED by scripts/gen_configs.py. Do not hand-edit.
! Source of truth: topology/dc-fabric.yml + topology/link-map.yml
!
! A leaf does the work the spine refuses to: it terminates hosts, owns the SVIs,
! and routes between VLANs locally. In Phase 1 an SVI exists here only if this leaf
! has a host in that VLAN -- with no L2 between leaves a second copy of the same
! gateway would be a duplicate address. Phase 2b's EVPN anycast gateway is what
! makes that same address legitimately present on every leaf.
!
hostname {{ name }}
!
no ip domain lookup
ip domain name {{ domain }}
! Without this the SVIs are just addresses and nothing routes between them.
ip routing
!
username {{ user }} privilege 15 secret {{ password }}
enable secret {{ password }}
!
{% if ssh_key %}
! Public-key auth alongside the password, not instead of it -- if the key ever
! fails to match (CiscoSSH quirk, key rotated), password login still gets you in.
ip ssh server algorithm publickey ssh-ed25519
ip ssh pubkey-chain
 username {{ user }}
  key-string
   {{ ssh_key.split(' ')[1] }}
  exit
 exit
!
{% endif %}
! VTP transparent, or none of the 'vlan' lines below do anything. A wiped IOL
! switch boots as a VTP server, which keeps VLANs in vlan.dat and silently skips
! 'vlan N' in the startup-config. VLANs with an access port got auto-created
! anyway (as VLAN0010, not 'app') -- which hid this until the L3VNI VLAN, which
! has no port by design, never came up. Also why leaf2 sent no EVPN type-3 route
! in Phase 2a: VLAN 10 did not exist there until a host was plugged in.
vtp mode transparent
!
{% for v in vlans %}
vlan {{ v.id }}
 name {{ v.name }}
!
{% endfor %}
{% if tenant %}
! ---- Phase 2b: tenant VRF ---------------------------------------------------
!
! Tenant host subnets are routed in VRF {{ tenant.vrf }}, not the global table. The
! 'stitching' route targets are the EVPN side of the same RT (what goes on type-2
! MAC/IP and type-5 routes); the plain ones are the IP VRF side. Same value for
! both, one AS -- nothing to keep in sync by hand.
!
! The leak: the jump's mgmt VLAN, the home LAN and a default come in from global
! (import map), and the tenant subnets go out to global (export map).
!
{% for p in leak.to_tenant %}
ip prefix-list MGMT-NETS seq {{ loop.index * 5 }} permit {{ p }}
{% endfor %}
{% for p in leak.to_global %}
ip prefix-list TENANT-NETS seq {{ loop.index * 5 }} permit {{ p }}
{% endfor %}
{% for p in leak.to_global %}
ip prefix-list TENANT-HOSTS seq {{ loop.index * 5 }} permit {{ p }} ge 32
{% endfor %}
!
route-map GLOBAL-TO-TENANT permit 10
 match ip address prefix-list MGMT-NETS
!
route-map TENANT-TO-GLOBAL permit 10
 match ip address prefix-list TENANT-NETS
!
! Host /32s too, but pinned to this leaf with no-advertise. Without them the
! global table only has the anycast /24 as "connected", so traffic from the jump
! to a host on ANOTHER leaf is ARPed for locally -- and the host's ARP reply goes
! to the anycast MAC, which its own leaf owns and swallows. The /32 steers the
! lookup across the L3VNI instead; no-advertise keeps host routes out of the
! underlay's BGP (the spines never see them).
route-map TENANT-TO-GLOBAL permit 20
 match ip address prefix-list TENANT-HOSTS
 set community no-advertise
!
vrf definition {{ tenant.vrf }}
 rd {{ loopback }}:1
 !
 address-family ipv4
  route-target export {{ tenant.route_target }}
  route-target import {{ tenant.route_target }}
  route-target export {{ tenant.route_target }} stitching
  route-target import {{ tenant.route_target }} stitching
  import ipv4 unicast map GLOBAL-TO-TENANT
  ! allow-evpn: without it only locally-originated VRF routes are exported, so
  ! the remote host /32s (learned as EVPN type-2) would never reach global.
  export ipv4 unicast map TENANT-TO-GLOBAL allow-evpn
 exit-address-family
!
{% endif %}
{% if dhcp_pools %}
! Host addressing is handed out by the leaf, not baked into the host.
!
! CML's alpine node takes a node.cfg that its generator parses for a few known
! directives -- 'hostname' lands, arbitrary shell does not -- so configuring the
! host directly is a dead end. DHCP sidesteps it entirely, and is what a real
! data center does anyway.
!
! One manual binding per host, keyed on the client-id of its fixed MAC (derived
! from its IP, see cml/hosts.py) -- no address pool at all, so an unknown client
! is offered nothing. A stretched VLAN's bindings exist on every leaf, because
! every leaf hears its broadcasts; identical bindings behind an identical anycast
! server address make it irrelevant which leaf answers first.
{% for p in dhcp_pools %}
ip dhcp pool {{ p.name }}
{% if p.vrf %}
 vrf {{ p.vrf }}
{% endif %}
 host {{ p.host }} {{ p.netmask }}
 client-identifier {{ p.client_id }}
 default-router {{ p.gateway }}
 dns-server {{ p.dns }}
 lease 0 8
!
{% endfor %}
{% endif %}
interface Loopback0
 description router-id and BGP peering source
 ip address {{ loopback }} 255.255.255.255
 ip ospf 1 area {{ area }}
!
{% for l in uplinks %}
interface {{ l.intf }}
 description uplink to {{ l.peer }}
 ! routed port, not a switchport -- this link carries the underlay, not VLANs
 no switchport
 ip address {{ l.ip }} 255.255.255.254
 ip ospf network point-to-point
 ip ospf 1 area {{ area }}
 no shutdown
!
{% endfor %}
{% for a in access_ports %}
interface {{ a.intf }}
 description {{ a.host }}
 switchport mode access
 switchport access vlan {{ a.vlan }}
 ! host port: forward immediately rather than spending 30s in listening/learning
 spanning-tree portfast
 no shutdown
!
{% endfor %}
{% for v in svis %}
interface Vlan{{ v.id }}
 description {{ v.name }} {{ 'anycast ' if v.anycast }}gateway
{% if v.vrf %}
 ! Same MAC on every leaf, not just the same IP: a host that moves leaves keeps
 ! a valid ARP entry for its gateway. Harmless on a VLAN that is not stretched.
 mac-address {{ tenant.gateway_mac }}
 ! vrf forwarding clears any address, so it must come before 'ip address'.
 vrf forwarding {{ v.vrf }}
{% endif %}
 ip address {{ v.gateway }} {{ v.netmask }}
{% if v.anycast %}
 ! IOL QUIRK, measured 26 Sep 2026: on ioll2-xe, CEF drops packets routed out of
 ! or into an SVI whose VLAN is bound to an EVPN instance. Traffic the leaf
 ! originates itself works (process-switched), which is why pings FROM the leaf
 ! succeeded while jump -> srv-app1 failed. Process switching this one SVI fixes
 ! it with EVPN still bound. Real Catalyst hardware does not need this line.
 no ip route-cache
{% endif %}
 no shutdown
!
{% endfor %}
{% if evpn_vlans %}
! ---- Phase 2: EVPN / VXLAN --------------------------------------------------
!
! This leaf is a VTEP. The spines are not -- they reflect the routes and never
! terminate a tunnel.
!
l2vpn evpn
 replication-type {{ overlay.replication }}
 router-id Loopback0
!
{% for v in evpn_vlans %}
! VLAN {{ v.id }} -> VNI {{ v.vni }}. Route targets are auto-derived (evi-id based),
! which is safe here precisely because every switch is in one AS: the RT both sides
! compute is identical, so there is nothing to keep in sync by hand.
l2vpn evpn instance {{ v.evi }} vlan-based
 encapsulation vxlan
 replication-type {{ overlay.replication }}
!
vlan configuration {{ v.id }}
 member evpn-instance {{ v.evi }} vni {{ v.vni }}
!
{% endfor %}
{% if tenant %}
! The L3VNI: one VNI per VRF, carrying every routed packet between leaves
! (symmetric IRB -- both ingress and egress leaf route). It needs a VLAN and an
! SVI to hang the VRF on, but no hosts and no address of its own.
vlan {{ tenant.l3vni_vlan }}
 name l3vni-{{ tenant.vrf | lower }}
!
vlan configuration {{ tenant.l3vni_vlan }}
 member vni {{ tenant.l3vni }}
!
interface Vlan{{ tenant.l3vni_vlan }}
 description L3VNI {{ tenant.l3vni }} for VRF {{ tenant.vrf }}
 vrf forwarding {{ tenant.vrf }}
 ip unnumbered Loopback0
 ! up even with no access port in the VLAN -- nothing local ever joins it
 no autostate
 ! Same IOL CEF quirk as the anycast SVIs: a packet decapsulated off the L3VNI and
 ! routed on to a local host is dropped on the fast path (leaf2 -> leaf1 worked,
 ! leaf1 -> leaf2 did not, on identical config). Process switching fixes it.
 no ip route-cache
 no shutdown
!
{% endif %}
! One tunnel interface carries every VNI. Sourcing it from Loopback0 is what makes
! the overlay inherit the underlay's ECMP -- the tunnel follows whichever spine
! OSPF prefers, and survives losing one.
interface nve1
 no shutdown
 source-interface Loopback0
 ! Peers are learned from BGP rather than configured. Adding a leaf changes no
 ! existing leaf's config, which is the same O(1) property the underlay has.
 host-reachability protocol bgp
{% for v in evpn_vlans %}
 member vni {{ v.vni }} ingress-replication
{% endfor %}
{% if tenant %}
 member vni {{ tenant.l3vni }} vrf {{ tenant.vrf }}
{% endif %}
!
{% endif %}
router ospf 1
 router-id {{ loopback }}
 passive-interface Loopback0
!
! OSPF carries only the underlay (loopbacks and /31s). Host subnets are advertised
! in BGP instead. At this size OSPF alone would work -- the split exists because it
! is what Phase 2's EVPN expects, so Phase 2 becomes an addition, not a rewrite.
router bgp {{ asn }}
 bgp router-id {{ loopback }}
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 neighbor SPINES peer-group
 neighbor SPINES remote-as {{ asn }}
 neighbor SPINES update-source Loopback0
{% for s in spines %}
 neighbor {{ s }} peer-group SPINES
{% endfor %}
 !
 address-family ipv4
{% for n in networks %}
  network {{ n.network }} mask {{ n.netmask }}
{% endfor %}
{% for s in spines %}
  neighbor {{ s }} activate
{% endfor %}
 exit-address-family
{% if evpn_vlans %}
 !
 ! Note there is no 'network' statement here and no redistribution: EVPN routes are
 ! originated from what the leaf learns on its access ports. A MAC appearing on
 ! Et1/1 becomes a type-2 advertisement on its own.
 address-family l2vpn evpn
  neighbor SPINES send-community both
{% for s in spines %}
  neighbor {{ s }} activate
{% endfor %}
 exit-address-family
{% endif %}
{% if tenant %}
 !
 ! Connected tenant subnets become type-5 routes; host MAC/IPs are type-2 on
 ! their own. Remote subnets come back in the same way, via the L3VNI.
 address-family ipv4 vrf {{ tenant.vrf }}
  advertise l2vpn evpn
  redistribute connected
 exit-address-family
{% endif %}
!
{% if static_routes %}
! Return path. Traffic from the home LAN arrives via the jump server; without a
! route back, replies leave for the default gateway and vanish. A ping that
! arrives and cannot answer looks exactly like a ping that never arrived.
{% for r in static_routes %}
ip route {{ r.network }} {{ r.netmask }} {{ r.via }}
{% endfor %}
!
{% endif %}
ip ssh version 2
line vty 0 4
 login local
 ! See spine.j2 -- telnet is the way back in on a box whose RSA key never generated.
 transport input telnet ssh
!
! NO EEM APPLET HERE, unlike spine.j2 -- and not an oversight.
!
! The ioll2-xe image (X86_64BI_LINUX_L2-ADVENTERPRISEK9-M, 17.16.1a) has no Embedded
! Event Manager at all: 'show event manager policy registered' is rejected as invalid
! input, and any 'event manager' lines in a startup-config are silently discarded --
! they do not even appear in 'show run'. A config that looks correct, applies without
! error, and does nothing.
!
! The image IS crypto-capable (adventerprisek9), so SSH works fine once a key exists.
! It just cannot generate one by itself. scripts/bootstrap_ssh.py does that over
! telnet, which is why telnet stays enabled above -- it is the only way in on a
! freshly wiped leaf.
end
