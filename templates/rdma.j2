#cloud-config
# {{ name }} -- GENERATED by scripts/add_rdma_host.py. Do not hand-edit.
#
# A fabric-only host: one NIC, on a leaf access port, and no path to the home
# LAN. That is deliberate rather than a limitation. CML locks a node's physical
# configuration while the lab is running, so giving this box a second NIC on the
# external connector would mean stopping the whole fabric to add one port to it.
# Reaching it through the jump box instead is also how you would reach a server
# in a real rack.
#
# The consequence to remember: no internet here. Packages come across the fabric
# from the jump box (see add_rdma_host.py), not from the Ubuntu archive.
hostname: {{ name }}
manage_etc_hosts: true

users:
  - name: {{ user }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: {{ password }}

ssh_pwauth: true

write_files:
  - path: /etc/netplan/60-lab.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          {{ fab_if }}:
            # VLAN {{ fab_vlan }} access port on {{ fab_peer }}
            addresses: [{{ fab_ip }}]
            routes:
              # Default via the leaf SVI: everything this host talks to is
              # inside the fabric, and the route makes the RDMA path to the
              # other VLANs cross the spine rather than dead-end.
              - to: default
                via: {{ fab_gateway }}
            nameservers:
              # A static address inherits no DNS. The route out exists only
              # once scripts/fabric_nat.py has made the jump box a NAT gateway;
              # without a resolver apt still fails while ping works, which
              # reads as "no internet" and is not.
              addresses: [{{ dns }}]

  # Soft-RoCE is built in software, so the defaults sized for a 1500-byte NIC
  # throttle it. Larger buffers cost memory this host has and buy measurable
  # throughput on ib_send_bw.
  - path: /etc/sysctl.d/99-rdma.conf
    content: |
      net.core.rmem_max=16777216
      net.core.wmem_max=16777216

runcmd:
  - [ netplan, apply ]
  - [ sysctl, --system ]
  - [ systemctl, enable, --now, ssh ]

final_message: "{{ name }} ready on {{ fab_ip }} -- reach it from the jump box"
