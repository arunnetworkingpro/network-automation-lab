#cloud-config
# jump -- GENERATED by scripts/gen_configs.py. Do not hand-edit.
#
# The jump server is the seam between two networks that know nothing about each
# other: the home LAN on {{ ext_ip }} and the fabric on {{ fab_ip }}. Everything
# below exists to make that seam work in both directions.
hostname: {{ name }}
manage_etc_hosts: true

users:
  - name: {{ user }}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: {{ password }}
{% if ssh_key %}
    ssh_authorized_keys:
      - {{ ssh_key }}
{% endif %}

ssh_pwauth: true

write_files:
  # Netplan, not DHCP. A lab box whose address moves is a lab box you cannot put
  # in an ssh config or an Ansible inventory.
  - path: /etc/netplan/60-lab.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          {{ fab_if }}:
            # fabric side -- VLAN {{ fab_vlan }} access port on {{ fab_peer }}
            addresses: [{{ fab_ip }}]
            # No gateway here on purpose: the default route belongs on the
            # home-LAN side. Two default routes would make the return path a
            # coin toss.
            routes:
              - to: 10.0.0.0/8
                via: {{ fab_gateway }}
          {{ ext_if }}:
            # home LAN side -- bridged onto {{ ext_ip }} via the System Bridge
            addresses: [{{ ext_ip }}]
            routes:
              - to: default
                via: {{ ext_gateway }}
            nameservers:
              # A static address inherits no DNS. Without this, apt and git
              # resolve nothing and the box looks "broken" while pinging fine.
              addresses: [{{ dns | join(', ') }}]

  # Forwarding is what makes this a jump *router* rather than just a host with two
  # addresses. Your phone reaches 10.10.10.11 because this box passes it along.
  - path: /etc/sysctl.d/99-lab-forward.conf
    content: |
      net.ipv4.ip_forward=1

packages:
  - python3
  - python3-pip
  - git
  - traceroute
  - tcpdump

runcmd:
  - [ netplan, apply ]
  - [ sysctl, --system ]
  - [ systemctl, enable, --now, ssh ]

final_message: "jump ready -- ssh {{ user }}@{{ ext_ip.split('/')[0] }}"
