[Unit]
Description=Prometheus exporter for the CML lab
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/Project/cml-datacenter
ExecStart=%h/Project/cml-datacenter/.venv/bin/python \
    %h/Project/cml-datacenter/monitoring/cml_exporter.py \
    --host 127.0.0.1 --port 9639

# The CML lab is often powered off while the exporter is up; that is a normal
# state, not a failure. Keep retrying rather than giving up.
Restart=always
RestartSec=15

# Reads ~/.cml.env, talks to CML over HTTPS, listens on loopback. Nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=default.target
